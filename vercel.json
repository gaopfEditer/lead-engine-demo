{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "demo_snapshot/**",
          "presets/**",
          "data/cslb_sample.meta.json",
          "app/web/templates/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/api/index.py" }]
}
